<?xml version="1.0" encoding="UTF-8"?>
<!--
  The mixed-server fleet (plan-java.md J5): the TypeScript reference server and the Java server on
  one PostgreSQL at once, Java and TypeScript devices on both. Not a module of the root build: run
  interop/server-fleet/run.sh (it installs the library first).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.crossben</groupId>
        <artifactId>accordsync-parent</artifactId>
        <version>0.3.2</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>accordsync-server-fleet</artifactId>
    <name>Accord mixed-server fleet</name>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency><groupId>io.github.crossben</groupId><artifactId>accordsync-client</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.github.crossben</groupId><artifactId>accordsync-server</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter-params</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <redirectTestOutputToFile>false</redirectTestOutputToFile>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
